# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=aadhar-documents
PORT=3000
 
# Cloudinary Configuration (Optional - for storing student photos & Aadhaar in Cloudinary)
# Obtain these from your Cloudinary Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively, use CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
